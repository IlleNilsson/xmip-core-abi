<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The .NET binding over the two normative headers, include/xmip_module.h and
    include/xmip_operate.h. ADR-0014, amendment of 2026-08-26: the cli, the
    PowerShell module and the GUI all P/Invoke the same C ABI, and writing
    those declarations three times would mean three things that must agree
    about struct layout, calling convention and lifetimes — the drift an ABI
    exists to prevent. So it is written once, here, beside the Rust binding:
    each export's symbol, and the structs and values that mirror the header.
    What calls through them — the Operate model, Xmip.Operate — is
    xmip-core-operate's, which every surface references (ADR-0052, amendment
    2026-11-16): a definition has no verb (ADR-0058, clause 1).

    ADR-0012 clause 1 applies: the header is normative and this is not. Where
    the two differ, the header is right and this is a defect.

    Target framework and the rest come from Directory.Build.props.
  -->

  <PropertyGroup>
    <RootNamespace>Xmip.Abi</RootNamespace>
    <AssemblyName>Xmip.Abi</AssemblyName>

    <!-- The whole point of this assembly is to cross a C ABI. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- C# 15's updated memory safety rules, a preview (adopted until the
         first Linear release): a pointer type is safe to name and pass; only
         a dereference and a call through a function pointer need an unsafe
         block, and a member whose safety rests on its caller is marked
         unsafe, so its caller needs one too. -->
    <LangVersion>preview</LangVersion>
    <Features>$(Features);updated-memory-safety-rules</Features>
    <!-- IDE0380 ("'unsafe' modifier is unnecessary") flags a member whose
         body is all in unsafe blocks, where the modifier now says its caller
         needs one; removing it drops that promise silently. Fixed in Roslyn
         (dotnet/roslyn#85732, a1bbcb8: a <safety> element keeps the modifier),
         not yet in SDK 11.0.100, whose analyzer still flags XmipStr.Read with
         a <safety> element (2026-11-12). Once an SDK carries it, XmipStr.Read's
         caller promise moves into <safety> and this line goes. -->
    <NoWarn>$(NoWarn);IDE0380</NoWarn>

    <!-- The cli publishes ahead-of-time. A binding it carries must not need
         anything the trimmer removes, and this asks the analyzers to say so. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

</Project>
