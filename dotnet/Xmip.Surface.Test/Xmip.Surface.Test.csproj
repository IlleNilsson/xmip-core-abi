<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The shared model's tests (ADR-0052 clause 6): the scope tree and its
    rollup, the worst leaf beneath a scope, runtime discovery, the English,
    the surface choice and the snapshot surface over a small TOML fixture.
    The rules beneath them are the runtime's (xmip_operate.h section 7), in
    the library Xmip.Abi's project copies beside this assembly; these prove
    the surface returns what the runtime answers, and test no rule again.
    Every .NET surface is a thin face over what is tested here, so this is
    where the board's answer is proved, not on the board.

    Target framework and the rest come from Directory.Build.props.
  -->

  <PropertyGroup>
    <RootNamespace>Xmip.Surface.Test</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xUnit v3: a test project is its own executable. `dotnet test`
         drives it through VSTest and xunit.runner.visualstudio, the way
         the estate's tooling calls it (Test-XmipDotnetModule); xunit.v3 4
         would otherwise make it a Microsoft.Testing.Platform application,
         which the .NET 10 and later SDK refuses under VSTest. -->
    <OutputType>Exe</OutputType>
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>

    <!-- Test classes are public for the runner, not for a reader. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Xmip.Surface\Xmip.Surface.csproj" />
    <ProjectReference Include="..\Xmip.Surface.Relay\Xmip.Surface.Relay.csproj" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The remote surface is proved against a real hub on a loopback port,
         hosted here the way the web host hosts it, over the same fixture. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- A snapshot as a node or the Playground publishes one, beside the
         test assembly. -->
    <None Include="Fixture\*.toml"
          Link="Fixture\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
