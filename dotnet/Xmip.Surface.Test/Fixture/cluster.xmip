# A snapshot as an Essentials roll publishes one since 2026-09-19: a cluster,
# its nodes, what each node declared it can do, what the run was started with
# under [run], and the topology the owner asked for — cluster, nodes, receive,
# process, send, the endpoints beneath receive and send, the handoffs
# receive -> process -> send, and the Parties outside (2026-09-29): the one
# that sends into the receive stages and the one the send stages deliver to.
#
# The names below are the test cluster's, test/cluster.xmip's (ADR-0056,
# amendment 2026-10-03), and a test reads them from there. They are what an
# operator typed and nothing more (ADR-0053): a node's name is not a
# criterion, and the node called PX1 proves it by declaring two stages and
# serving one. Capability is what a node could do (ADR-0056),
# never what its name looks like and never what it happened to do this round.

source = "essentials — xmip:///CL1"
node = "xmip:///CL1"

[[records]]
scope = "xmip:///CL1/node/RX1/capability"
state = "fine"
severity = 0
evidence = "declares receiving; online; authentication and runtime capability are not modeled"
observed_unix_nanos = 1789111688000000000

[[records]]
scope = "xmip:///CL1/node/PX1/capability"
state = "fine"
severity = 0
evidence = "declares processing,sending; offline; authentication and runtime capability are not modeled"
observed_unix_nanos = 1789111688000000000

[[records]]
scope = "xmip:///CL1/node/TX1/capability"
state = "fine"
severity = 0
evidence = "declares sending; offline; authentication and runtime capability are not modeled"
observed_unix_nanos = 1789111688000000000

[[records]]
scope = "xmip:///CL1/node"
state = "stressed"
severity = 39
evidence = "3 nodes, 5 of 6 leaves fine; worst TX1/send/tcp/json: 2/3 rounds passed, 1 failed"
observed_unix_nanos = 1789111688000000000

[[records]]
scope = "xmip:///CL1/node/RX1/system-process"
state = "fine"
severity = 0
evidence = "alive"
observed_unix_nanos = 1789111688000000000

[[records]]
scope = "xmip:///CL1/node/RX1/receive/tcp/json"
state = "fine"
severity = 0
evidence = "3/3 rounds passed"
observed_unix_nanos = 1789111688000000000

[[records]]
scope = "xmip:///CL1/node/RX1/receive/file/text"
state = "fine"
severity = 0
evidence = "3/3 rounds passed"
observed_unix_nanos = 1789111688000000000

[[records]]
scope = "xmip:///CL1/node/PX1/process/tcp/json"
state = "fine"
severity = 0
evidence = "3/3 rounds passed"
observed_unix_nanos = 1789111688000000000

[[records]]
scope = "xmip:///CL1/node/TX1/send/tcp/json"
state = "stressed"
severity = 40
evidence = "2/3 rounds passed, 1 failed"
observed_unix_nanos = 1789111688000000000

[[records]]
scope = "xmip:///CL1/node/TX1/send/file/text"
state = "fine"
severity = 0
evidence = "3/3 rounds passed"
observed_unix_nanos = 1789111688000000000

# Each count at the stage that took it, as a roll publishes since 2026-09-26:
# a reader sums what is beneath any scope it is asked about.
[[counts]]
counted = "streams"
value = 6
scope = "xmip:///CL1/node/RX1/receive"

[[counts]]
counted = "journeys"
value = 6
scope = "xmip:///CL1/node/PX1/process"

[[counts]]
counted = "messages"
value = 5
scope = "xmip:///CL1/node/TX1/send"

[run]
cluster = "CL1"
tests = ["RoundTrip"]
nodes = ["RX1", "PX1", "TX1"]
roles = ["RX1=receiving", "PX1=processing+sending", "TX1=sending"]
online = ["RX1"]
stress = "realistic"

# Each node of the cluster says the roles it declares (ADR-0052 and ADR-0056,
# amendments 2026-11-13): where the reader stands it on the map, by role and
# never by name, and what its tooltip says it is for.
[topology]
source = "essentials — cluster CL1"
observed_unix_nanos = 1789111688000000000

[[topology.nodes]]
id = "cluster"
parent = ""
label = "CL1"
kind = "cluster"
scope = "xmip:///CL1"
state = "stressed"
origin = "configured"
load = 0.0
activity = 1.5
evidence = "3 nodes, 5 of 6 leaves fine"

[[topology.nodes]]
id = "node/RX1"
parent = "cluster"
label = "RX1"
kind = "node"
scope = "xmip:///CL1/node/RX1"
state = "fine"
origin = "both"
load = 0.0
activity = 1.5
