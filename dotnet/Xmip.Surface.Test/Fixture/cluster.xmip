# The Parties outside the cluster (ADR-0052, amendment 2026-09-29): the
# Essentials' one Party, drawn once on each side it is on. Which side is said
# by its links, never by its id or its name.
[[topology.nodes]]
id = "party/sending/party-x"
parent = "cluster"
label = "party-x"
kind = "party"
scope = "xmip:///CL1/party/party-x"
state = "fine"
origin = "both"
load = 0.0
activity = 1.5
evidence = "sends into RX1; worst at RX1 over file: 3/3 rounds passed"

[[topology.nodes]]
id = "party/receiving/party-x"
parent = "cluster"
label = "party-x"
kind = "party"
scope = "xmip:///CL1/party/party-x"
state = "holding"
origin = "both"
load = 0.0
activity = 1.5
evidence = "is delivered to by PX1, TX1; worst at TX1 over tcp: 2/3 rounds passed, 1 failed"

# Every pair the roster configures a handoff between, and the hops delivered
# over each (the owner, 2026-09-25: configured traffic and its usage): RX1 to
# PX1 and PX1 to TX1 are configured and used, PX1's own process to its send stage
# is configured and has carried nothing. The rate is the rise per second over
# the roll's window, and each drawn thing's activity what moved through it per
# second, as the window states it from these links and the counts beneath it
# (ADR-0052, amendment 2026-11-10): 1.5 on every thing a used link runs into
# or out of, on their nodes and on the cluster, and 0 on the endpoints, which
# have nothing counted beneath them, and on PX1's send stage, whose links
# carried nothing.
[[topology.links]]
id = "handoff/RX1/receive/PX1/process"
from = "node/RX1/receive"
to = "node/PX1/process"
pattern = "send-receive"
origin = "both"
protocol = "handoff"
state = "fine"
volume = 6
rate = 1.5
latency_ms = 0.0
progress = 0.0
attempts = 0
evidence = "6 handoffs RX1 to PX1; worst leaf at either end: 3/3 rounds passed"

