# A second cluster rolling beside the one in cluster.xmip. Two rolls are two
# clusters (ADR-0052, amendment 2026-09-14, ruling 1), each publishing its own
# file, and a face holds both at once (amendment 2026-09-20). Small on purpose:
# what it has to carry is its own [run].cluster, its own scope root and enough
# topology for a view to draw something that is plainly not CL1's.

source = "essentials — xmip:///CL2"
node = "xmip:///CL2"

[[records]]
scope = "xmip:///CL2/node/RX1/capability"
state = "fine"
severity = 0
evidence = "declares receiving; online"
observed_unix_nanos = 1789111688000000000

[[records]]
scope = "xmip:///CL2/node/RX1/receive/tcp/json"
state = "fine"
severity = 0
evidence = "3/3 rounds passed"
observed_unix_nanos = 1789111688000000000

[[records]]
scope = "xmip:///CL2/node/TX1/send/tcp/json"
state = "done"
severity = 95
evidence = "connection refused by billing-x (10.0.9.7:5671)"
observed_unix_nanos = 1789111688000000000

[[counts]]
counted = "streams"
value = 2

[[counts]]
counted = "journeys"
value = 2

[[counts]]
counted = "messages"
value = 1

[run]
cluster = "CL2"
tests = ["RoundTrip"]
nodes = ["RX1", "TX1"]
roles = ["RX1=receiving", "TX1=sending"]
online = ["RX1"]
stress = "harsh"

# Nothing rose over the window its roll keeps: its one link's rate is zero,
# and every drawn thing's activity, what moved through it per second, too
# (ADR-0052, amendment 2026-11-10).
[topology]
source = "essentials — cluster CL2"
observed_unix_nanos = 1789111688000000000

[[topology.nodes]]
id = "cluster"
parent = ""
label = "CL2"
kind = "cluster"
scope = "xmip:///CL2"
state = "done"
origin = "configured"
load = 0.0
activity = 0.0
evidence = "2 nodes, 1 of 2 leaves fine"

[[topology.nodes]]
id = "node/RX1"
parent = "cluster"
label = "RX1"
kind = "node"
scope = "xmip:///CL2/node/RX1"
state = "fine"
origin = "both"
load = 0.0
activity = 0.0
evidence = "3/3 rounds passed"

[[topology.nodes]]
id = "node/TX1"
parent = "cluster"
label = "TX1"
kind = "node"
scope = "xmip:///CL2/node/TX1"
state = "done"
origin = "both"
load = 0.0
activity = 0.0
evidence = "connection refused by billing-x (10.0.9.7:5671)"

[[topology.links]]
id = "RX1->TX1"
from = "node/RX1"
to = "node/TX1"
pattern = "send-receive"
origin = "observed"
protocol = "handoff"
state = "done"
volume = 1
rate = 0.0
latency_ms = 0.0
progress = 1.0
attempts = 1
evidence = "1 handoff delivered"
