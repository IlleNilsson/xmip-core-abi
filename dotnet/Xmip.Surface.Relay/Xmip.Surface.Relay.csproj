<Project Sdk="Microsoft.NET.Sdk">

  <!--
    What a web host adds to the surfaces it serves its browsers: where it
    binds and how (SurfaceBinding, ADR-0063 clause 1) and who each request
    proved (ProvenCaller, ADR-0009, amendment 2026-10-06). SignalR here is
    only server-side Blazor's own circuit to the browser; a remote surface
    follows a node over gRPC to its operate listener, never a web host
    (ADR-0014, amendment 2026-10-12). Only a web host references this, so
    nothing of ASP.NET Core reaches pwsh or the desktop. Target framework
    and the rest come from Directory.Build.props.
  -->

  <PropertyGroup>
    <RootNamespace>Xmip.Surface.Relay</RootNamespace>
    <AssemblyName>Xmip.Surface.Relay</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Xmip.Surface\Xmip.Surface.csproj" />
  </ItemGroup>

</Project>
