<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The binding's tests. The ones that matter compare the C# against the
    headers themselves — every status, every health mood, every counted kind,
    the versions and the entrypoints — so that ADR-0012 clause 1 ("the header
    is normative and this is not") fails a build rather than a module load.
    The headers are copied beside the test assembly so the comparison needs no
    path into the repository.

    Target framework and the rest come from Directory.Build.props.
  -->

  <PropertyGroup>
    <RootNamespace>Xmip.Abi.Test</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xUnit v3: a test project is its own executable. `dotnet test`
         drives it through VSTest and xunit.runner.visualstudio, the way
         the estate's tooling calls it (Test-XmipDotnetModule); xunit.v3 4
         would otherwise make it a Microsoft.Testing.Platform application,
         which the .NET 10 and later SDK refuses under VSTest. -->
    <OutputType>Exe</OutputType>
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>

    <!-- Test classes are public for the runner, not for a reader. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Xmip.Abi\Xmip.Abi.csproj" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The test cluster's names, read by the one helper every .NET test
         shares (ADR-0056, amendment 2026-10-03); it reads through the
         surface's one TOML reader. -->
    <ProjectReference Include="..\Xmip.Surface\Xmip.Surface.csproj" />
    <Compile Include="..\Xmip.Surface.Test\TestCluster.cs" Link="TestCluster.cs" />
    <Using Include="Xmip.Surface.Test" />
  </ItemGroup>

  <ItemGroup>
    <!-- The normative headers, beside the assembly. -->
    <None Include="..\..\include\*.h"
          Link="include\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
